{
  "name": "vitamine-und-skorbut",
  "version": "1.0.0",
  "private": true,
  "description": "Vitamine & Skorbut – animierter Erklärfilm (Natur & Technik, 3. Sek). Remotion + React + TypeScript.",
  "license": "UNLICENSED",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts VitamineSkorbut out/vitamine-und-skorbut.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:draft": "remotion render src/index.ts VitamineSkorbut out/vitamine-und-skorbut-entwurf.mp4 --codec=h264 --crf=28 --pixel-format=yuv420p --scale=0.5",
    "still": "remotion still src/index.ts VitamineSkorbut out/still.png --frame=60",
    "frames": "node scripts/render-test-frames.mjs",
    "typecheck": "tsc --noEmit",
    "check:timing": "node scripts/check-timing.mjs",
    "upgrade": "remotion upgrade",
    "docs": "node scripts/build-docs.mjs",
    "audio": "node scripts/generate-audio.mjs",
    "textures": "node scripts/generate-textures.mjs",
    "render:stiltest": "remotion render src/index.ts StilTest out/stiltest-v2.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --gl=angle"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@remotion/media": "4.0.538",
    "@remotion/noise": "4.0.538",
    "@remotion/three": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.538",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
